# Django settings
# SECRET_KEY: mínimo de 50 caracteres; o settings.py recusa chaves curtas.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Esse formato não tem caracteres especiais. Se usar outra chave, coloque-a
# entre aspas simples: um "#" sem aspas inicia um comentário e corta o valor,
# e um valor que começa com "$" é lido como referência a outra variável.
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (PostgreSQL) — porta 5433 exposta pelo docker-compose.yml
DATABASE_URL=postgres://barbershop_user:barbershop_pass@localhost:5433/barbershop_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Cookie settings
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax

# Email
DEFAULT_FROM_EMAIL=no-reply@barbearia.local

# Frontend API URL (used by Vite)
VITE_API_URL=http://127.0.0.1:8000/api/v1